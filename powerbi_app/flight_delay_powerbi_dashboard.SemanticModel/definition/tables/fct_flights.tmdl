table fct_flights
	lineageTag: 649347d9-bf03-473a-adc8-cd77f12c7938

	measure 'Total Flights' = COUNTROWS(fct_flights)
		formatString: 0
		lineageTag: ca62bb49-2a88-47ab-81f4-10f2cfcae660

	measure '% Delayed' =
			
			DIVIDE(
			    CALCULATE(COUNTROWS(fct_flights), fct_flights[arr_delay_15plus] = TRUE),
			    [Total Flights]
			)
		lineageTag: 218e5ac1-f50e-42ed-a8b0-c94acab340a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Arrival Delay' = AVERAGE(fct_flights[arr_delay])
		lineageTag: 05c61bdb-4fe4-4e25-a4c9-27050844a45b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Flights to Destination' =
			
			CALCULATE(
			    COUNTROWS(fct_flights),
			    USERELATIONSHIP(fct_flights[dest_airport_sk], dim_airports[airport_sk])
			)
		formatString: 0
		lineageTag: c139f209-d7cd-47cb-b21b-4e490be219b1

